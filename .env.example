# Healthcare AI Assistant — Environment Configuration
# Copy this file to .env and edit as needed

# ── Ollama LLM Settings ──────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
# Other supported models: mistral, phi3, gemma, llama3:8b

# ── Embedding Model ──────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Vector Store ─────────────────────────────────────────
VECTOR_STORE_PATH=./vector_store
COLLECTION_NAME=healthcare_docs

# ── Document Settings ────────────────────────────────────
DATA_DIR=./data
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── RAG Settings ─────────────────────────────────────────
TOP_K_RESULTS=4
SIMILARITY_THRESHOLD=0.3

# ── API Settings ─────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
